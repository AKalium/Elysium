[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true

[remote "origin"]
	fetch = +refs/heads/*:refs/remotes/origin/*
	url = https://github.com/AKalium/Elysium.git
[branch "asset"]
	merge = refs/heads/asset
	remote = origin
	vscode-merge-base = origin/main
